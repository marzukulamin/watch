    "three": "0.180.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1",
    "prettier": "3.6.2",
    "sharp": "0.35.5",
    "vite": "7.3.7"
