PORT=3000
HOST=127.0.0.1
DB_DRIVER=sqlite
DB_FILE=database/verse.sqlite
# Use mysql for a production install managed in local phpMyAdmin.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=verse
MYSQL_USER=verse_app
MYSQL_PASSWORD=
APP_ORIGIN=http://localhost:3000
# Set true behind HTTPS in production.
SECURE_COOKIES=false
# Development asset generation only; never prefix these with VITE_.
GOOGLE_CLOUD_PROJECT=jerserio-project
GOOGLE_CLOUD_LOCATION=global
GCLOUD_EXECUTABLE=E:/Google cloud CLI/google-cloud-sdk/bin/gcloud.ps1
